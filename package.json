{
  "name": "neon-lane-runner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Neon Lane Runner - a three-lane endless runner for desktop and mobile browsers.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:arcade": "node scripts/arcade-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.47.2",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
